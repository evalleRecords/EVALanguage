proc vTclWindow.top1 {base} {
    global vTcl
    if {$base == ""} {
        set base .top1
    }
    if {[winfo exists $base]} {
        wm deiconify $base; return
    }
    set top $base
    set target $base
    ###################
    # CREATING WIDGETS
    ###################
    vTcl::widgets::core::toplevel::createCmd $top -class Toplevel \
        -menu $top.m53 -background #d9d9d9 
    wm focusmodel $top passive
    wm geometry $top 600x581+739+182
    update
    # set in toplevel.wgt.
    global vTcl
    global img_list
    set vTcl(save,dflt,origin) 0
    wm maxsize $top 1905 1050
    wm minsize $top 1 1
    wm overrideredirect $top 0
    wm resizable $top 1 1
    wm deiconify $top
    set toptitle "Toplevel 0"
    wm title $top $toptitle
    namespace eval ::widgets::${top}::ClassOption {}
    set ::widgets::${top}::ClassOption(-toptitle) $toptitle
    vTcl:DefineAlias "$top" "selectTopicCombobox" vTcl:Toplevel:WidgetProc "" 1
    set vTcl(real_top) {}
    menu "$top.m53" \
        -activebackground #d9d9d9 -activeforeground black \
        -font "-family {DejaVu Sans} -size 10" -tearoff 0 
    button "$top.but56" \
        -activebackground #d9d9d9 -activeforeground black -background #d9d9d9 \
        -font "-family {DejaVu Sans} -size 10" -foreground #000000 \
        -text "START QUESTION" 
    vTcl:DefineAlias "$top.but56" "questionButton" vTcl:WidgetProc "selectTopicCombobox" 1
    button "$top.but58" \
        -activebackground #d9d9d9 -activeforeground black -background #d9d9d9 \
        -font "-family {DejaVu Sans} -size 10" -foreground #000000 \
        -text "NEXT" 
    vTcl:DefineAlias "$top.but58" "nextQuestion" vTcl:WidgetProc "selectTopicCombobox" 1
    button "$top.but69" \
        -activebackground #d9d9d9 -activeforeground black -background #d9d9d9 \
        -font "-family {DejaVu Sans} -size 10" -foreground #000000 \
        -text "PLAY MEMORIZATION" 
    vTcl:DefineAlias "$top.but69" "playMemorizationButton" vTcl:WidgetProc "selectTopicCombobox" 1
    checkbutton "$top.che67" \
        -activebackground #d9d9d9 -activeforeground black -anchor w \
        -background #d9d9d9 -compound left \
        -font "-family {DejaVu Sans} -size 10" -foreground #000000 \
        -justify left -text "Enable Shadowing" -variable "che67" 
    vTcl:DefineAlias "$top.che67" "autoShadowing" vTcl:WidgetProc "selectTopicCombobox" 1
    button "$top.but59" \
        -activebackground #d9d9d9 -activeforeground black -background #d9d9d9 \
        -font "-family {DejaVu Sans} -size 10" -foreground #000000 \
        -text "REPEAT QUESTION" 
    vTcl:DefineAlias "$top.but59" "repeatQuestion" vTcl:WidgetProc "selectTopicCombobox" 1
    entry "$top.ent51" \
        -background white -font "-family {DejaVu Sans Mono} -size 10" \
        -foreground #000000 -selectbackground #d9d9d9 -selectforeground black \
        -width 556 
    vTcl:DefineAlias "$top.ent51" "userAnswer" vTcl:WidgetProc "selectTopicCombobox" 1
    button "$top.but57" \
        -activebackground #d9d9d9 -activeforeground black -background #d9d9d9 \
        -font "-family {DejaVu Sans} -size 10" -foreground #000000 \
        -text "SEND ANSWER" 
    vTcl:DefineAlias "$top.but57" "answerButton" vTcl:WidgetProc "selectTopicCombobox" 1
    button "$top.but68" \
        -activebackground #d9d9d9 -activeforeground black -background #d9d9d9 \
        -font "-family {DejaVu Sans} -size 10" -foreground #000000 \
        -text "GIVE ME ANSWER" 
    vTcl:DefineAlias "$top.but68" "giveAnswerButton" vTcl:WidgetProc "selectTopicCombobox" 1
    text "$top.tex47" \
        -background white -font "-family {DejaVu Sans} -size 10" \
        -foreground black -height 245 -selectbackground #d9d9d9 \
        -selectforeground black -width 556 -wrap word 
    $top.tex47 configure -font "TkTextFont"
    $top.tex47 insert end text
    vTcl:DefineAlias "$top.tex47" "assistantText" vTcl:WidgetProc "selectTopicCombobox" 1
    label "$top.lab52" \
        -activebackground #d9d9d9 -activeforeground black -anchor w \
        -background #d9d9d9 -compound left \
        -font "-family {DejaVu Sans} -size 10" -foreground #000000 \
        -text "My Answer" 
    vTcl:DefineAlias "$top.lab52" "Label1" vTcl:WidgetProc "selectTopicCombobox" 1
    label "$top.lab50" \
        -activebackground #d9d9d9 -activeforeground black -anchor w \
        -background #d9d9d9 -compound left \
        -font "-family {DejaVu Sans} -size 10" -foreground #000000 \
        -text "Assistant:" 
    vTcl:DefineAlias "$top.lab50" "assistant" vTcl:WidgetProc "selectTopicCombobox" 1
    ttk::combobox "$top.tCo71" \
        -font "-family {DejaVu Sans} -size 10" -textvariable "combobox" 
    vTcl:DefineAlias "$top.tCo71" "TCombobox1" vTcl:WidgetProc "selectTopicCombobox" 1
    label "$top.lab72" \
        -activebackground #d9d9d9 -activeforeground black -anchor w \
        -background #d9d9d9 -compound left \
        -font "-family {DejaVu Sans} -size 10" -foreground #000000 \
        -text "select your topic" 
    vTcl:DefineAlias "$top.lab72" "selectTopic" vTcl:WidgetProc "selectTopicCombobox" 1
    scale "$top.sca63" \
        -activebackground #d9d9d9 -background #d9d9d9 -bigincrement 0.0 \
        -font "-family {DejaVu Sans} -size 10" -foreground #000000 -from 0.0 \
        -length 144 -orient horizontal -resolution 1.0 -tickinterval 0.0 \
        -to 100.0 -troughcolor #c4c4c4 
    vTcl:DefineAlias "$top.sca63" "speed" vTcl:WidgetProc "selectTopicCombobox" 1
    label "$top.lab64" \
        -activebackground #d9d9d9 -activeforeground black -anchor w \
        -background #d9d9d9 -compound left \
        -font "-family {DejaVu Sans} -size 10" -foreground #000000 \
        -text "SPEED" 
    vTcl:DefineAlias "$top.lab64" "speed" vTcl:WidgetProc "selectTopicCombobox" 1
    checkbutton "$top.che70" \
        -activebackground #d9d9d9 -activeforeground black -anchor w \
        -background #d9d9d9 -compound left \
        -font "-family {DejaVu Sans} -size 10" -foreground #000000 \
        -justify left -text "Enable Random Topic" -variable "che70" 
    vTcl:DefineAlias "$top.che70" "enableRandmTopic" vTcl:WidgetProc "selectTopicCombobox" 1
    ###################
    # SETTING GEOMETRY
    ###################
    place $top.but56 \
        -in $top -x 0 -relx 0.033 -y 0 -rely 0.868 -width 141 -relwidth 0 \
        -height 31 -relheight 0 -anchor nw -bordermode ignore 
    place $top.but58 \
        -in $top -x 0 -relx 0.283 -y 0 -rely 0.868 -width 71 -relwidth 0 \
        -height 61 -relheight 0 -anchor nw -bordermode ignore 
    place $top.but69 \
        -in $top -x 0 -relx 0.417 -y 0 -rely 0.925 -width 161 -relwidth 0 \
        -height 31 -relheight 0 -anchor nw -bordermode ignore 
    place $top.che67 \
        -in $top -x 0 -relx 0.417 -y 0 -rely 0.868 -width 0 -relwidth 0.245 \
        -height 0 -relheight 0.049 -anchor nw -bordermode ignore 
    place $top.but59 \
        -in $top -x 0 -relx 0.717 -y 0 -rely 0.868 -width 141 -relwidth 0 \
        -height 31 -relheight 0 -anchor nw -bordermode ignore 
    place $top.ent51 \
        -in $top -x 0 -relx 0.033 -y 0 -rely 0.642 -width 556 -relwidth 0 \
        -height 113 -relheight 0 -anchor nw -bordermode ignore 
    place $top.but57 \
        -in $top -x 0 -relx 0.033 -y 0 -rely 0.925 -width 141 -relwidth 0 \
        -height 31 -relheight 0 -anchor nw -bordermode ignore 
    place $top.but68 \
        -in $top -x 0 -relx 0.717 -y 0 -rely 0.925 -width 141 -relwidth 0 \
        -height 31 -relheight 0 -anchor nw -bordermode ignore 
    place $top.tex47 \
        -in $top -x 0 -relx 0.033 -y 0 -rely 0.138 -width 0 -relwidth 0.927 \
        -height 0 -relheight 0.461 -anchor nw -bordermode ignore 
    place $top.lab52 \
        -in $top -x 0 -relx 0.033 -y 0 -rely 0.602 -width 0 -relwidth 0.165 \
        -height 0 -relheight 0.046 -anchor nw -bordermode ignore 
    place $top.lab50 \
        -in $top -x 0 -relx 0.033 -y 0 -rely 0.086 -width 0 -relwidth 0.115 \
        -height 0 -relheight 0.052 -anchor nw -bordermode ignore 
    place $top.tCo71 \
        -in $top -x 0 -relx 0.033 -y 0 -rely 0.034 -width 0 -relwidth 0.662 \
        -height 0 -relheight 0.04 -anchor nw -bordermode ignore 
    place $top.lab72 \
        -in $top -x 0 -relx 0.033 -y 0 -width 0 -relwidth 0.198 -height 0 \
        -relheight 0.036 -anchor nw -bordermode ignore 
    place $top.sca63 \
        -in $top -x 0 -relx 0.717 -y 0 -rely 0.069 -width 0 -relwidth 0.24 \
        -height 42 -relheight 0 -anchor nw -bordermode ignore 
    place $top.lab64 \
        -in $top -x 0 -relx 0.8 -y 0 -rely 0.052 -width 0 -relwidth 0.082 \
        -height 0 -relheight 0.028 -anchor nw -bordermode ignore 
    place $top.che70 \
        -in $top -x 0 -relx 0.383 -y 0 -width 0 -relwidth 0.295 -height 0 \
        -relheight 0.024 -anchor nw -bordermode ignore 

    vTcl:FireEvent $base <<Ready>>
}

proc 36 {args} {return 1}


Window show .
set btop1 ""
if {$vTcl(borrow)} {
    set btop1 .bor[expr int([expr rand() * 100])]
    while {[lsearch $btop1 $vTcl(tops)] != -1} {
        set btop1 .bor[expr int([expr rand() * 100])]
    }
}
set vTcl(btop) $btop1
Window show .top1 $btop1
if {$vTcl(borrow)} {
    $btop1 configure -background plum
}

